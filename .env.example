# Copie para .env e ajuste. O .env nunca vai para o Git.
# Todas as variáveis têm valor padrão para rodar localmente com Ollama.

# --- Banco de dados (formato JDBC) ---
DB_URL=jdbc:postgresql://localhost:5432/sabia
DB_USERNAME=sabia
DB_PASSWORD=sabia

# --- Segurança ---
# Obrigatório trocar em produção. Pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48).
JWT_SEGREDO=troque-este-segredo-local-por-um-com-32-caracteres-ou-mais
JWT_VALIDADE=12h
# Permite que qualquer pessoa cadastre uma empresa. Em uma demo pública, deixe false.
CADASTRO_ABERTO=true
# Só se o front-end ficar em outro domínio (separado por vírgula).
CORS_ORIGENS=

# --- Modelos de IA (qualquer API compatível com a da OpenAI) ---
# Ollama local:
IA_BASE_URL=http://localhost:11434
IA_API_KEY=ollama
IA_MODELO_CHAT=qwen2.5:3b
IA_MODELO_EMBEDDING=bge-m3
# Dimensão dos vetores do modelo de embedding (bge-m3 = 1024). Defina ANTES do primeiro deploy.
EMBEDDING_DIMENSIONS=1024
# Caminhos dos endpoints (mude só para provedores que não usam o padrão /v1/..., como o Gemini).
IA_CHAT_PATH=/v1/chat/completions
IA_EMBEDDINGS_PATH=/v1/embeddings

# --- Busca (RAG) ---
RAG_TRECHOS_POR_BUSCA=5
RAG_SIMILARIDADE_MINIMA=0.4
RAG_TAMANHO_TRECHO=1200
RAG_SOBREPOSICAO=200

# --- Demonstração e custo ---
DEMO_HABILITADA=false
DEMO_SENHA=demo1234
# Zero desliga o limite.
LIMITE_PERGUNTAS_POR_HORA=30

# --- Login ---
# Senhas erradas por e-mail (e por IP) em uma janela de N minutos antes de bloquear.
LOGIN_TENTATIVAS_POR_EMAIL=5
LOGIN_TENTATIVAS_POR_IP=30
LOGIN_JANELA_MINUTOS=15

# --- Painel de análises ---
FUSO_HORARIO=America/Sao_Paulo
